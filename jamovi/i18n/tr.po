msgstr "* |artık| > %.2f olan hücreleri işaretler"

#: R/chisqposttest.b.R
msgid "\\u{2022} |Residual| > 2.0: Suggests meaningful deviation"
msgstr "\\u{2022} |Artık| > 2.0: Anlamlı sapmaya işaret eder"

#: R/chisqposttest.b.R
msgid "\\u{2022} |Residual| > 3.0: Strong evidence of deviation"
msgstr "\\u{2022} |Artık| > 3.0: Sapmanın güçlü kanıtı"

#: R/chisqposttest.b.R
msgid ""
"\\u{2022} Compare the adjusted p-values against \\u{3B1} = %g, not the raw "
"ones"
msgstr ""
"\\u{2022} Düzeltilmiş p-değerlerini ham olanlarla değil, \\u{3B1} = %g ile "
"karşılaştırın"

#: R/venn.b.R
msgid "\\u{2022} Enable 'Show ggVennDiagram Plot' instead"
msgstr "\\u{2022} Bunun yerine 'ggVennDiagram Grafiğini Göster'i etkinleştirin"

#: R/chisqposttest.b.R
msgid "\\u{2022} Equivalent per-comparison level:"
msgstr "\\u{2022} Karşılaştırma başına eşdeğer düzey:"

#: R/venn.b.R
msgid "\\u{2022} ggVennDiagram supports 5+ variables with better visualization"
msgstr "\\u{2022} ggVennDiagram daha iyi görselleştirme ile 5+ değişkeni destekler"

#: R/chisqposttest.b.R
msgid "\\u{2022} Method:"
msgstr "\\u{2022} Yöntem:"

#: R/chisqposttest.b.R
msgid "\\u{2022} Negative values: Under-represented (fewer than expected)"
msgstr "\\u{2022} Negatif değerler: Yetersiz temsil edilen (beklenenden az)"

#: R/chisqposttest.b.R
msgid "\\u{2022} Number of comparisons:"
msgstr "\\u{2022} Karşılaştırma sayısı:"

#: R/chisqposttest.b.R
msgid "\\u{2022} Positive values: Over-represented (more than expected)"
msgstr "\\u{2022} Pozitif değerler: Fazla temsil edilen (beklenenden fazla)"

#: R/venn.b.R
msgid "\\u{2022} Reduce to 4 or fewer variables for ggvenn visualization"
msgstr "\\u{2022} ggvenn görselleştirmesi için 4 veya daha az değişkene indirin"

#: R/venn.b.R
msgid "\\u{2022} Use UpSetR or ComplexUpset plots for complex intersections"
msgstr ""
"\\u{2022} Karmaşık kesişimler için UpSetR veya ComplexUpset grafiklerini "
"kullanın"

#: R/chisqposttest.b.R
msgid "\\u{B1}%s for significance"
msgstr "anlamlılık için \\u{B1}%s"

